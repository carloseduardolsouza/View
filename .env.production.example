# Copy to .env.production (never commit it) and fill in. Used by infra/docker-compose.prod.yml.
VERSION=1.0.0
# REGISTRY=registry.example.org/view
PUBLIC_HOST=viewer.example.org
# HTTP_PORT=80
# HTTPS_PORT=443
# CERT_DIR=./certs   # must contain fullchain.pem and privkey.pem

# Application database. Inside containers "localhost" is the container itself: use the service name,
# a hostname, or host.docker.internal for a Postgres on the Docker host.
DATABASE_URL=postgres://view:CHANGE_ME@host.docker.internal:5432/view
# POSTGRES_PASSWORD=CHANGE_ME   # only with --profile db

# PACS (Orthanc with the DICOMweb plugin). Credentials stay on the server side.
ORTHANC_URL=http://host.docker.internal:8042
ORTHANC_USER=CHANGE_ME
ORTHANC_PASSWORD=CHANGE_ME

LOG_LEVEL=info
# AUDIT_RETENTION_DAYS=365   # used by scripts/audit-retention.sh
# RATE_LIMIT_MAX=6000   # API requests per IP per minute
