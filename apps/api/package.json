{
  "name": "@view/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file=../../.env src/server.ts",
    "bootstrap": "tsx --env-file=../../.env src/bootstrap.ts",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@view/contracts": "workspace:*",
    "fastify": "5.12.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6"
  }
}
